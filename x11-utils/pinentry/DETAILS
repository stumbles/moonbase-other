          MODULE=pinentry
         VERSION=1.3.3
          SOURCE=$MODULE-$VERSION.tar.bz2
      SOURCE_URL=https://www.gnupg.org/ftp/gcrypt/pinentry/
      SOURCE_VFY=sha256:c2970f16d6afb66ecddfca767d743936c86239bff936eed7fd7597a678414b63
        WEB_SITE=https://www.gnupg.org/aegypten/development.en.html
         ENTERED=20030310
         UPDATED=20260926
           SHORT="A collection of simple PIN or passphrase entry dialogs"

cat << EOF
This is a collection of simple PIN or passphrase entry dialogs which utilize
the Assuan protocol as described by the aegypten project; see
    http://www.gnupg.org/aegypten/
for details.
There are programs for different toolkits available. For all GUIs it is
automatically detected which modules can be built, but it can also be
requested explicitely.
EOF
